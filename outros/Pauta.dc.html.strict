      </sc-if>

      <!-- INBOX VIEW -->
      <sc-if value="{{ viewInbox }}" hint-placeholder-val="{{ false }}">
        <div style="margin-bottom:20px;">
          <h1 style="margin:0;font-size:20px;font-weight:600;letter-spacing:-0.02em;">Inbox</h1>
          <p style="color:var(--pb-text-muted);font-size:13px;margin:3px 0 0;">Captura rápida de ideias e pendências. Classifique depois em projeto, prioridade e prazo.</p>
        </div>

        <div style="display:flex;gap:8px;margin-bottom:20px;max-width:640px;">
          <input type="text" placeholder="Digite uma tarefa para capturar..." value="{{ inboxDraft }}" onChange="{{ onInboxDraftChange }}" onKeyDown="{{ onInboxKeyDown }}" style="flex:1;height:36px;padding:6px 12px;font:inherit;font-size:13.5px;background:var(--pb-surface);border:1px solid var(--pb-border);border-radius:6px;" />
          <button onClick="{{ addInboxTask }}" style="cursor:pointer;font-family:inherit;font-weight:500;font-size:13px;color:var(--pb-on-accent);background:var(--pb-accent);border:none;border-radius:6px;padding:0 16px;box-shadow:0 1px 2px rgba(0,0,0,0.1);transition:all .12s ease;" style-hover="opacity:0.92;">Adicionar</button>
