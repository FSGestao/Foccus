        <a href="#" title="{{ item.tooltip }}" onClick="{{ item.onClick }}" style="{{ item.style }}" style-hover="background:var(--pb-hover);color:var(--pb-text);" aria-current="{{ item.ariaCurrent }}">
          <span style="display:inline-flex;flex:none;opacity:0.85;" aria-hidden="true">{{ item.icon }}</span>
          <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ true }}">
            <span style="flex:1;white-space:nowrap;">{{ item.label }}</span>
          </sc-if>
        </a>
      </sc-for>
    </nav>

    <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ true }}">
      <div style="margin-top:auto;padding:10px 8px 4px;border-top:1px solid var(--pb-border);display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--pb-text-dim);">
        <span>{{ currentDateStr }}</span>
        <span style="font-weight:500;color:var(--pb-text-muted);">v1.2</span>
      </div>
