        </div>
        
        <div role="region" aria-label="Quadro Kanban" style="display:flex;gap:16px;overflow-x:auto;padding-bottom:16px;min-height:400px;align-items:flex-start;">
          <sc-for list="{{ kanbanColumns }}" as="col" hint-placeholder-count="4">
            <div onDragOver="{{ col.onDragOver }}" onDrop="{{ col.onDrop }}" role="group" aria-label="Coluna: {{ col.label }}" style="width:280px;flex-shrink:0;background:var(--pb-surface-subtle);border-radius:8px;padding:12px;display:flex;flex-direction:column;gap:12px;max-height:calc(100vh - 180px);overflow-y:auto;border:1px solid var(--pb-border);transition:background .15s ease;">
              <div style="display:flex;align-items:center;justify-content:space-between;">
                <span style="font-size:12px;font-weight:600;letter-spacing:0.02em;text-transform:uppercase;color:var(--pb-text-dim);">{{ col.label }}</span>
                <span style="font-size:11px;background:var(--pb-surface);border:1px solid var(--pb-border);border-radius:12px;padding:1px 6px;color:var(--pb-text-muted);font-weight:500;">{{ col.cards.length }}</span>
              </div>
              
              <div style="display:flex;flex-direction:column;gap:8px;min-height:20px;">
                <sc-for list="{{ col.cards }}" as="card" hint-placeholder-count="3">
                  <div onClick="{{ card.onOpen }}" role="article" aria-label="{{ card.title }}" style="background:var(--pb-surface);border:1px solid var(--pb-border);border-radius:6px;padding:10px 12px;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,0.03);transition:transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;" style-hover="transform:translateY(-2px) scale(1.01);box-shadow:0 6px 16px rgba(0,0,0,0.1);border-color:var(--pb-accent);">
                    <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:8px;">
                      <button onClick="{{ card.onToggle }}" aria-label="Concluir" style="{{ card.checkStyle }} margin-top:2px;">{{ card.checkMark }}</button>
                      <div style="{{ card.titleStyle }};line-height:1.35;flex:1;">{{ card.title }}</div>
                    </div>
                    
                    <div style="display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-left:24px;">
                      <span style="font-size:11px;padding:1px 5px;border-radius:4px;border:1px solid var(--pb-border);{{ card.priorityStyle }}">{{ card.priorityLabel }}</span>
                      
                      <span style="display:inline-flex;align-items:center;gap:3px;font-size:11px;color:var(--pb-text-dim);background:var(--pb-surface-subtle);border:1px solid var(--pb-border);border-radius:4px;padding:1px 5px;">
                        <span style="{{ card.projectDotStyle }}"></span>
                        <span style="max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ card.projectName }}</span>
                      </span>
                      
                      <sc-if value="{{ card.showDate }}" hint-placeholder-val="{{ false }}">
                        <span style="display:inline-flex;align-items:center;gap:3px;font-size:11px;white-space:nowrap;{{ card.dateStyle }} padding:1px 5px;border-radius:4px;background:var(--pb-surface-subtle);border:1px solid var(--pb-border);">
                          <span>🗓</span>
                          <span>{{ card.dateLabel }}</span>
                        </span>
                      </sc-if>
                      
                      <sc-if value="{{ card.showWaiting }}" hint-placeholder-val="{{ false }}">
                        <span style="display:inline-flex;align-items:center;font-size:11px;color:oklch(62% 0.14 75);background:rgba(234,179,8,0.1);padding:1px 5px;border-radius:4px;border:1px solid rgba(234,179,8,0.2);white-space:nowrap;">
