            <div onClick="{{ row.onOpen }}" style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid var(--pb-border);cursor:pointer;transition:background .1s ease;" style-hover="background:var(--pb-hover);">
              <button onClick="{{ row.onToggle }}" aria-label="Concluir" style="{{ row.checkStyle }}">{{ row.checkMark }}</button>
              <div style="flex:1;font-size:14px;font-weight:500;">{{ row.title }}</div>
              <span style="font-size:12px;font-weight:500;color:var(--pb-accent);display:inline-flex;align-items:center;gap:4px;">Classificar →</span>
            </div>
          </sc-for>
          <sc-if value="{{ inboxEmpty }}" hint-placeholder-val="{{ false }}">
            <div style="color:var(--pb-text-muted);font-size:13.5px;padding:36px 16px;text-align:center;">Inbox vazio. Tudo classificado!</div>
          </sc-if>
        </div>
      </sc-if>

      <!-- PROJECTS VIEW -->
      <sc-if value="{{ viewProjects }}" hint-placeholder-val="{{ false }}">
