      <sc-if value="{{ viewList }}" hint-placeholder-val="{{ true }}">
        
        <!-- View Header & Stats Strip -->
        <div style="margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;">
          <div>
            <h1 onClick="{{ onChangeName }}" style="margin:0;font-size:20px;font-weight:600;letter-spacing:-0.02em;cursor:pointer;display:inline-flex;align-items:center;gap:6px;" title="Alterar Nome" style-hover="color:var(--pb-accent);">Lista de {{ userFirstName }} <span style="font-size:14px;opacity:0.5;">✎</span></h1>
            <div style="font-size:12.5px;color:var(--pb-text-muted);margin-top:2px;">Visualização operacional de tarefas e compromissos</div>
          </div>

          <!-- Summary Metric Cards -->
          <div style="display:flex;align-items:stretch;background:var(--pb-surface);border:1px solid var(--pb-border);border-radius:8px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,0.03);">
            <sc-for list="{{ summaryStats }}" as="stat" hint-placeholder-count="4">
              <div onClick="{{ stat.onClick }}" style="padding:7px 14px;border-right:1px solid var(--pb-border);display:flex;flex-direction:column;align-items:center;min-width:72px;cursor:pointer;transition:background .1s ease;" style-hover="background:var(--pb-hover);" title="Filtrar por {{ stat.label }}">
                <div style="font-weight:600;font-size:16px;line-height:1.2;font-variant-numeric:tabular-nums;">{{ stat.value }}</div>
                <div style="font-size:10.5px;font-weight:500;letter-spacing:0.02em;color:var(--pb-text-dim);margin-top:2px;text-transform:uppercase;">{{ stat.label }}</div>
              </div>
            </sc-for>
          </div>
        </div>

        <!-- Filter Tabs & Group By Controls -->
        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--pb-border);margin-bottom:12px;padding-bottom:2px;overflow-x:auto;">
          <div style="display:flex;gap:4px;">
            <sc-for list="{{ tabs }}" as="tab" hint-placeholder-count="2">
              <a href="#" onClick="{{ tab.onClick }}" style="{{ tab.style }}" style-hover="color:var(--pb-text);background:var(--pb-hover);">{{ tab.label }}</a>
            </sc-for>
          </div>
          <div style="display:flex;align-items:center;gap:6px;padding-bottom:4px;flex-shrink:0;">
            <label style="font-size:11.5px;font-weight:500;color:var(--pb-text-dim);white-space:nowrap;">Agrupar:</label>
            <select value="{{ groupBy }}" onChange="{{ onGroupByChange }}" style="font:inherit;font-size:12px;color:var(--pb-text);background:var(--pb-surface);border:1px solid var(--pb-border);border-radius:5px;padding:3px 8px;cursor:pointer;">
              <option value="none">Nenhum</option>
              <option value="project">Projeto</option>
              <option value="priority">Urgência</option>
              <option value="due">Prazo</option>
            </select>
          </div>
        </div>

        <!-- Quick Filters -->
        <sc-if value="{{ viewList }}" hint-placeholder-val="{{ true }}">
          <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:12px;">
            <div style="display:flex;gap:8px;overflow-x:auto;align-items:center;">
              <sc-for list="{{ quickFilters }}" as="qf" hint-placeholder-count="4">
