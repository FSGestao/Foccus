      </div>

    </div>
    <!-- Barra de Progresso Global -->
    <div role="progressbar" aria-valuenow="{{ progressPct }}" aria-valuemin="0" aria-valuemax="100" aria-label="Progresso das tarefas de hoje" title="{{ progressPct }}% das tarefas de hoje concluídas ({{ doneTasks }}/{{ totalTasks }})" style="height:2px;background:var(--pb-border);">
      <div style="{{ progressBarStyle }}"></div>
    </div>
  </header>

  <!-- Sidebar Overlay / Drawer -->
  <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ false }}">
    <div onClick="{{ toggleMenu }}" style="position:fixed;inset:0;background:rgba(0,0,0,0.35);backdrop-filter:blur(2px);z-index:18;transition:all 0.2s ease;"></div>
  </sc-if>
  <!-- Sidebar (Mini Rail) -->
  <aside style="{{ sidebarStyle }}">
    <div style="{{ sidebarHeaderStyle }}">
      <div style="display:flex;align-items:center;gap:8px;">
        <div style="width:20px;height:20px;border-radius:5px;background:var(--pb-accent);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:11px;flex-shrink:0;">F</div>
        <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ true }}">
          <span style="font-weight:600;font-size:14px;white-space:nowrap;">Navegação</span>
        </sc-if>
      </div>
    </div>

    <div style="{{ sidebarActionStyle }}">
      <button onClick="{{ openNewTaskModal }}" title="Nova tarefa" style="{{ newTaskButtonStyle }}" style-hover="opacity:0.92;box-shadow:0 2px 8px rgba(99,102,241,0.35);transform:translateY(-0.5px);">
        <span style="font-size:14px;line-height:1;font-weight:600;">+</span>
        <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ true }}">
          <span style="white-space:nowrap;">Tarefa</span>
        </sc-if>
      </button>
      <button onClick="{{ addPersonFromMenu }}" title="Cadastrar nova pessoa" style="{{ newPersonButtonStyle }}" style-hover="background:var(--pb-hover);">
        <span style="font-size:14px;line-height:1;font-weight:600;">+</span>
        <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ true }}">
          <span style="white-space:nowrap;">Pessoa</span>
        </sc-if>
      </button>
    </div>

    <sc-if value="{{ menuOpen }}" hint-placeholder-val="{{ true }}">
