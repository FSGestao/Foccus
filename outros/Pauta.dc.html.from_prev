33: <script>
34: (function() {
35:   // Monitoramento de desempenho (Foccus Performance Monitor)
36:   var t0 = performance.now();
37:   window.addEventListener('load', function() {
38:     var loadTime = Math.round(performance.now() - t0);
39:     console.info('[Foccus] Tempo de carregamento completo: ' + loadTime + ' ms');
40:     // Detecta LCP via PerformanceObserver (suportado em Chrome/Edge)
41:     if (typeof PerformanceObserver !== 'undefined') {
42:       try {
43:         var po = new PerformanceObserver(function(list) {
44:           var entries = list.getEntries();
45:           var last = entries[entries.length - 1];
46:           console.info('[Foccus] LCP (Largest Contentful Paint): ' + Math.round(last.startTime) + ' ms' + (last.startTime > 2500 ? ' ⚠️ acima do ideal (> 2500 ms)' : ' ✅ dentro do ideal'));
47:           po.disconnect();
48:         });
49:         po.observe({ type: 'largest-contentful-paint', buffered: true });
50:       } catch(e) { /* navegador não suporta LCP observer */ }
51:     }
52:   });
53: })();
54: </script>
